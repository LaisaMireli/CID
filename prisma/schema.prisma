generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "sqlite" 
  url      = env("DATABASE_URL") 
}


model Measurement {
  id           Int      @id @default(autoincrement()) 
  
  temperature  Float?   
  humidity     Float?   
  soilMoisture Int?     
  luminosity   Int?
  
  
  errors       String // Um único texto para guardar os erros, separados por vírgula.
  
  createdAt    DateTime @default(now()) 
}


model SystemStatus {
  id              Int      @id @default(autoincrement()) 

  batteryLevel    Int
  connectionLevel Int
  currentActivity String
  currentSector   String

  createdAt       DateTime @default(now()) 
}

model User {
  id        Int      @id @default(autoincrement()) 
  name      String
  email     String   @unique 
  password  String   
  
  createdAt DateTime @default(now())
}


model RobotCommand {
  id         Int      @id @default(autoincrement())
  path       Json     
  isExecuted Boolean  @default(false) 
  createdAt  DateTime @default(now())
}