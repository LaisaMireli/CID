// Bloco que configura o gerador de código do Prisma
generator client {
  provider = "prisma-client-js"
}

// Bloco que configura a fonte de dados (nosso banco de dados)
datasource db {
  provider = "sqlite" // Estamos dizendo ao Prisma que vamos usar SQLite
  url      = env("DATABASE_URL") // O endereço do banco está no arquivo .env
}

// ------ NOSSAS TABELAS ------

// Tabela para guardar os dados de medição dos sensores
model Measurement {
  id           Int      @id @default(autoincrement()) // ID único para cada linha
  
  // Dados dos sensores (baseado no JSON "Measurement")
  temperature  Float?   // Campo do tipo número com casas decimais. O '?' significa que pode ficar em branco.
  humidity     Float?   
  soilMoisture Int?     // Campo do tipo número inteiro.
  luminosity   Int?
  
  // Campo para os erros (baseado no JSON "Measurement")
  errors       String // Um único texto para guardar os erros, separados por vírgula.
  
  createdAt    DateTime @default(now()) // Registra a data e hora exata que o dado foi salvo.
}

// Tabela para guardar os dados de status do sistema
model SystemStatus {
  id              Int      @id @default(autoincrement()) // ID único

  // Dados de status (baseado no JSON "SystemStatus")
  batteryLevel    Int
  connectionLevel Int
  currentActivity Int
  currentSector   String

  createdAt       DateTime @default(now()) // Registra a data e hora.
}

// Tabela para guardar os dados dos usuários
model User {
  id        Int      @id @default(autoincrement()) // ID único
  email     String   @unique // Email do usuário, deve ser único
  password  String   // Senha do usuário (vamos salvar uma versão criptografada)
  
  createdAt DateTime @default(now())
}